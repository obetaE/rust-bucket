{
  "name": "rustbucket-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "setup": "pnpm install",
    "dev": "nodemon --exec \"ts-node --esm src/index.ts --no-warnings\"",
    "seed": "ts-node --esm src/seed.ts --no-warnings",
    "build": "tsc --noEmit",
    "start": "node --experimental-strip-types src/index.ts"
  },
  "type": "module",
  "license": "ISC",
  "packageManager": "pnpm@10.16.1",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.7.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3"
  }
}
